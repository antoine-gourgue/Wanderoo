# Copiez ce fichier en `.env` et renseignez vos valeurs.

# --- Base de données PostgreSQL ---
# Local (Docker Compose fourni, port 5544 pour éviter un Postgres déjà sur 5432) :
DATABASE_URL="postgresql://wanderoo:wanderoo@localhost:5544/wanderoo?schema=public"
# Neon / Supabase (exemple) :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth.js ---
# Générez-en un avec : openssl rand -base64 32
AUTH_SECRET=""

# --- API partenaire ---
# TRAVELPAYOUTS_TOKEN=""
# TRAVELPAYOUTS_MARKER=""
